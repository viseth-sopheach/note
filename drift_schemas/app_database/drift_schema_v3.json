      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"folders\" (\"id\" TEXT NOT NULL, \"name\" TEXT NOT NULL, \"parent_id\" TEXT NULL REFERENCES folders (id) ON DELETE CASCADE, \"created_at\" INTEGER NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "notebooks",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"notebooks\" (\"id\" TEXT NOT NULL, \"title\" TEXT NOT NULL, \"folder_id\" TEXT NULL REFERENCES folders (id) ON DELETE CASCADE, \"cover_color_value\" INTEGER NOT NULL, \"template\" TEXT NOT NULL, \"created_at\" INTEGER NOT NULL, \"updated_at\" INTEGER NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "pages",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"pages\" (\"id\" TEXT NOT NULL, \"notebook_id\" TEXT NOT NULL REFERENCES notebooks (id) ON DELETE CASCADE, \"page_index\" INTEGER NOT NULL, \"strokes\" BLOB NOT NULL, \"template\" TEXT NULL, \"updated_at\" INTEGER NOT NULL, PRIMARY KEY (\"id\"), UNIQUE (\"notebook_id\", \"page_index\"));"
